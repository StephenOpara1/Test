<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %></title>
    <link href="../css/universal.css" rel="stylesheet">
    <link href="../css/all.min.css" rel="stylesheet">
    <link href="../css/animate.min.css" rel="stylesheet">
    <style>
        main{
            display: flex;
            justify-content: center;
            flex-direction: column;
            align-items: center;
        }main > div{
            border-bottom: 2px solid rgb(0, 128, 111);
            border-top: 2px solid rgb(0, 128, 111);
            padding: 1rem;
        }@media(min-width: 750px){
            main > div{
                display: flex;
                flex-direction: row;
                width: 100%;
                justify-content: space-around;
                align-items: center;
            }main > div > div{
                transform: scale(1.3);
            }
        }
    </style>
</head>
<body>
    <header style="display: flex; flex-direction: row; justify-content: space-between; align-items: center; height: 10vh; margin: 0 10px 0 10px;">
        <!--logo-->
        <div>Lozik</div>
        <!--shopping list-->
        <div style="height: 100%; width: 6rem; background: rgb(255, 255, 174); padding: 6px;">
            <span id="totalNum"></i></span> <i class="fas fa-shopping-bag"></i><br>
            <span id="totalPrice" style="margin-top: 7px; display: inline-block; word-wrap: break-word; width: 100%; overflow-y: scroll;"></span>
        </div>
        <!--navigation-->
        <a onclick="displayNavigation()"><i class="fas fa-bars" style="transform: scale(1.7);"></i></a>
    </header>

    <nav id="nav">
        <a href="/home">Home</a><br>
        <a href="/about">About</a><br>
        <a href="/services">Services</a><br>
        <a href="/shop">Shop</a><br>
        <a href="/book">Book</a><br>
        <a href="/contact">Contact</a><br>
    </nav>


    <main style="padding: 1rem;">
        <div>
            <img style="width: 270px; height: 350px; background-color: black;" src=<%= imageurl %>/>
            <div>
                <h3 style="font-family: serif; color: rgb(94, 94, 94); font-weight: 100;"><%= category %></h3>
                <h1 style="color: rgb(0, 68, 42); font-family: serif; font-weight: 100;"><%= name %></h1>
                <h1 style="color: rgb(73, 42, 12); font-family: serif; font-weight: 100;">N<%= Number(price).toLocaleString() %></h1>
                <span style="border: 1px solid gray; padding: 5px; font-size: .9rem;">Add to cart<i style="padding: 20px;" class="fas fa-plus" onclick="addToCart('<%= id %>')"></i></span>
            </div>
        </div>
        <h2 style="color: rgb(0, 59, 37); font-family: serif; font-weight: 100;">Description</h2>
        <p style="font-size: .9rem; line-height: 1.5; color: rgb(56, 56, 56); text-align: left;">
            <%= description %>
        </p>
    </main>








    <script src="../js/universal.js"></script>
</body>
</html>